      "index": "a7",
      "roundness": null,
      "seed": 1346076799,
      "version": 407,
      "versionNonce": 557330449,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1790667052436,
      "link": null,
      "locked": false,
      "text": "-> low cost\n-> high speed \n-> asked multiple question in single time\n-> all options have there own confidence score\n-> they not fake and hallucinate the answer",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "-> low cost\n-> high speed \n-> asked multiple question in single time\n-> all options have there own confidence score\n-> they not fake and hallucinate the answer",
      "autoResize": true,
      "lineHeight": 1.25
    },
